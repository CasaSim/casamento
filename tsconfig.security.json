{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "./src",
    "outDir": "./.test-build",
    "noEmit": false,
    "noEmitOnError": true,
    "incremental": false,
    "plugins": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", ".next", ".test-build"]
}
